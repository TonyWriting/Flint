{
  "version": 1,
  "executor": "kubectl",
  "rules": [
    {
      "command": [
        "get",
        "pods"
      ],
      "read_only": true,
      "options": {
        "--context": {
          "required": true,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,255}$"
        },
        "--output": {
          "values": [
            "json",
            "yaml",
            "wide",
            "name"
          ]
        },
        "--request-timeout": {
          "pattern": "^[1-9][0-9]{0,2}s$"
        },
        "--namespace": {
          "required": true,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"
        }
      },
      "positionals": {
        "max": 1,
        "pattern": "^[a-z0-9][a-z0-9.-]{0,252}$"
      }
    },
